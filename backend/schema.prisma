  teamId         String?      @map("team")
  attendances    Attendance[] @relation("Attendance_match")
  periods        Period[]     @relation("Period_match")
  goals          Goal[]       @relation("Goal_match")
  weekTheme      WeekTheme?   @relation("Match_weekTheme", fields: [weekThemeId], references: [id])
  weekThemeId    String?      @map("weekTheme")
  evaluations    Evaluation[] @relation("Evaluation_match")

  @@index([teamId])
