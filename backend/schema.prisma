datasource postgresql {
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
  provider          = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model Trainer {
  id       String  @id @default(cuid())
  name     String  @default("")
  email    String  @unique @default("")
  password String
  role     String? @default("trainer")
  team     Team?   @relation("Team_trainer")
}

model Team {
  id        String   @id @default(cuid())
  name      String   @default("")
  category  String
  club      String   @default("")
  active    String?  @default("true")
  trainer   Trainer? @relation("Team_trainer", fields: [trainerId], references: [id])
  trainerId String?  @unique @map("trainer")
  players   Player[] @relation("Player_team")
  matches   Match[]  @relation("Match_team")
}

model Player {
  id          String       @id @default(cuid())
  name        String       @default("")
  number      Int?
  position    String?
  active      String?      @default("true")
  team        Team?        @relation("Player_team", fields: [teamId], references: [id])
  teamId      String?      @map("team")
  attendances Attendance[] @relation("Attendance_player")
  goals       Goal[]       @relation("Goal_player")

  @@index([teamId])
}

model Match {
  id             String       @id @default(cuid())
  opponent       String       @default("")
  date           DateTime
  location       String?      @default("home")
  status         String?      @default("planned")
  currentPeriod  Int?         @default(0)
  periodStatus   String?      @default("idle")
  scoreHome      Int?         @default(0)
  scoreAway      Int?         @default(0)
  matchStartTime DateTime?
  team           Team?        @relation("Match_team", fields: [teamId], references: [id])
  teamId         String?      @map("team")
  attendances    Attendance[] @relation("Attendance_match")
  periods        Period[]     @relation("Period_match")
  goals          Goal[]       @relation("Goal_match")

  @@index([teamId])
}

model Period {
  id              String    @id @default(cuid())
  match           Match?    @relation("Period_match", fields: [matchId], references: [id])
  matchId         String?   @map("match")
  periodNumber    Int
  scoreHome       Int?      @default(0)
  scoreAway       Int?      @default(0)
  startTime       DateTime?
  endTime         DateTime?
  durationSeconds Int?      @default(900)

  @@index([matchId])
}

model Goal {
  id           String    @id @default(cuid())
  player       Player?   @relation("Goal_player", fields: [playerId], references: [id])
  playerId     String?   @map("player")
  match        Match?    @relation("Goal_match", fields: [matchId], references: [id])
  matchId      String?   @map("match")
  periodNumber Int?      @default(1)
  scoredAt     DateTime?

  @@index([playerId])
  @@index([matchId])
}

model Attendance {
  id               String            @id @default(cuid())
  player           Player?           @relation("Attendance_player", fields: [playerId], references: [id])
  playerId         String?           @map("player")
  match            Match?            @relation("Attendance_match", fields: [matchId], references: [id])
  matchId          String?           @map("match")
  present          String?           @default("false")
  selected         String?           @default("false")
  playTimeSessions PlayTimeSession[] @relation("PlayTimeSession_attendance")

  @@index([playerId])
  @@index([matchId])
}

model PlayTimeSession {
  id              String      @id @default(cuid())
  attendance      Attendance? @relation("PlayTimeSession_attendance", fields: [attendanceId], references: [id])
  attendanceId    String?     @map("attendance")
  period          Int?        @default(1)
  fieldPosition   String      @default("")
  startTime       DateTime?
  endTime         DateTime?
  durationSeconds Int?        @default(0)
  active          String?     @default("false")

  @@index([attendanceId])
}
